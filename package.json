{
  "name": "aix-package-porter",
  "displayName": "AIX Package Porter",
  "description": "Installs and manages the AIX Package Porter skill for Bob IDE (VS Code fork)",
  "version": "0.0.1",
  "publisher": "your-publisher-name",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "AIX",
    "Power Systems",
    "ppc64",
    "porting",
    "IBM",
    "Big Endian",
    "claude",
    "bob",
    "skill",
    "compiler",
    "gcc",
    "xlc"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aix-porter.installSkill",
        "title": "AIX Porter: Install Skill"
      },
      {
        "command": "aix-porter.reinstallSkill",
        "title": "AIX Porter: Reinstall Skill"
      },
      {
        "command": "aix-porter.uninstallSkill",
        "title": "AIX Porter: Uninstall Skill"
      },
      {
        "command": "aix-porter.showInfo",
        "title": "AIX Porter: Show Skill Information"
      }
    ],
    "configuration": {
      "title": "AIX Package Porter",
      "properties": {
        "aixPorter.autoInstall": {
          "type": "boolean",
          "default": true,
          "description": "Automatically install the skill on extension activation"
        },
        "aixPorter.skillPath": {
          "type": "string",
          "default": "",
          "description": "Custom path for skill installation (leave empty for default ~/.bob/skills)"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/aix-package-porter"
  },
  "bugs": {
    "url": "https://github.com/your-username/aix-package-porter/issues"
  },
  "homepage": "https://github.com/your-username/aix-package-porter#readme",
  "license": "MIT",
  "author": {
    "name": "Your Name",
    "email": "your.email@example.com"
  }
}